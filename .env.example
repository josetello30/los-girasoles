# =============================================================================
# Variables de entorno - Club Residencial Los Girasoles
# Copia este archivo:   cp .env.example .env
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# Los valores de abajo son solo para DESARROLLO local.
# =============================================================================

# ---------------- PostgreSQL (superusuario del contenedor)
POSTGRES_DB=girasoles
POSTGRES_USER=girasoles
POSTGRES_PASSWORD=girasoles_dev_2026
# Puerto del HOST. Se usa 5433 porque Fedora suele traer PostgreSQL ocupando el 5432.
# Dentro de Docker la BD sigue escuchando en 5432 (el backend no se ve afectado).
POSTGRES_PORT=5433

# ---------------- Rol del backend (lectura/escritura, sin DDL)
APP_DB_USER=girasoles_app
APP_DB_PASSWORD=app_dev_2026

# ---------------- Rol del dashboard Streamlit (solo lectura)
DASHBOARD_DB_USER=girasoles_dashboard
DASHBOARD_DB_PASSWORD=dashboard_dev_2026

# ---------------- Backend (API REST)
BACKEND_PORT=3000
# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres. CÁMBIALA fuera de desarrollo.
JWT_SECRET=dev-girasoles-cambiar-esta-clave-en-produccion-2026
JWT_EXPIRA=8h
# Orígenes permitidos (CORS). '*' solo en desarrollo.
CORS_ORIGINS=*
# Minutos para pagar una reserva antes de que se libere la franja
RESERVA_PENDIENTE_MINUTOS=30

# ---------------- Herramientas
ADMINER_PORT=8080
